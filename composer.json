{
    "name": "marcemarin/typesafe-laravel",
    "description": "Unofficial Laravel/PHP SDK for TypeSafe AI's System One decision model (Jev): typed choice, score and yes/no judgments, a validation rule and test fakes.",
    "keywords": ["laravel", "php", "typesafe", "typesafe-ai", "jev", "system-one", "classification", "moderation", "decision-model", "ai"],
    "license": "MIT",
    "homepage": "https://github.com/marcemarin/typesafe-laravel",
    "authors": [
        {
            "name": "Marcelo Marin",
            "email": "marcelo.marin.salvagiot@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Marcemarin\\TypeSafe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marcemarin\\TypeSafe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "check": [
            "@test",
            "@analyse",
            "vendor/bin/pint --test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marcemarin\\TypeSafe\\TypeSafeServiceProvider"
            ],
            "aliases": {
                "TypeSafe": "Marcemarin\\TypeSafe\\Facades\\TypeSafe"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
